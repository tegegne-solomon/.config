{
  "layer": "top",
  "position": "top",
  "height": 15,

  "modules-left": ["hyprland/workspaces"],

  "modules-center": [],

  "modules-right": [
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "clock"
  ],



  "network": {
    "format-wifi": "{signalStrength}%",
    "tooltip-format": "{ifname}: {ipaddr}",
  },

  "pulseaudio": {
    "format": "{volume}%",
    "on-click": "pavucontrol",
  },

  "backlight": {
    "format": "{percent}%",
    "device": "intel_backlight",
  },

  "battery": {
    "format": "{capacity}%",
    "states": {
      "warning": 20,
      "critical": 10,
    },
  },

  "clock": {
    "format": "{:%H:%M}",
  },

  "tray": {
    "icon-size": 14,
    "spacing": 5,
  },
}
